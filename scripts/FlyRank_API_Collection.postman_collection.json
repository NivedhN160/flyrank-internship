            "body": {
              "mode": "raw",
              "raw": "{\"widget_id\": \"demo-widget-id\", \"name\": \"Sarah Connor\", \"email\": \"sarah@skynet.ai\", \"message\": \"Deploying AI agent\", \"origin\": \"http://customer.local\"}"
            },
            "url": "http://localhost:8000/api/v1/leads"
          }
        }
      ]
    },
    {
      "name": "Capstone 2: Image Understanding Engine",
      "item": [
        {
